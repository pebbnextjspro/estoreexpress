PORT=4000
HOST=localhost
USER=root
DATABASE=ecomm
DB_PORT=3306   
NODE_ENV=development
PRODUCT_LIST_QUERY="select ROW_NUMBER() OVER (ORDER BY pr.id) AS SrNo,pr.id, pr.ProductName ,
    pr.ProductDescription, ct.CategoryName ,pr.ProductCategory,pr.ProductSubCategory,pr.ProductBrand,
     sct.SubCategory,br.BrandName,pr.ProductNewPrice,
pr.ProductOldPrice,pr.ProductsInStock,pr.ProductRating,pr.ProductColor,pr.ProductImages1,pr.ProductImages4,
pr.ProductWeight, pr.ProductShipCharges
from categories ct , products pr , tblsubcategories sct, tblbrands br
where pr.ProductCategory = ct.id and pr.ProductSubCategory = sct.id and pr.ProductBrand = br.BrandId
"